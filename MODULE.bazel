module(
    name = "vig",
    version = "0.0.0",
)

bazel_dep(name = "rules_zig", version = "0.16.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "vig_assembler", version = "0.1.0")
bazel_dep(name = "vig_bytecode", version = "0.1.0")

local_path_override(
    module_name = "vig_assembler",
    path = "../vig-assembler",
)

local_path_override(
    module_name = "vig_bytecode",
    path = "../vig-bytecode",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libffi",
    build_file = "//bazel/libffi:libffi.BUILD.bazel",
    sha256 = "f3a3082a23b37c293a4fcd1053147b371f2ff91fa7ea1b2a52e335676bac82dc",
    strip_prefix = "libffi-3.5.2",
    urls = ["https://github.com/libffi/libffi/releases/download/v3.5.2/libffi-3.5.2.tar.gz"],
)

zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.index(file = "@vig_bytecode//:zig-index.json")
zig.toolchain(zig_version = "0.17.0-dev.1543+6db520a4c")
