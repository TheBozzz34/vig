.{
    // This is the default name for a package that depends on this one. For
    // example, if a user runs `zig fetch --save <url>`, this field becomes the
    // key in the `dependencies` table. The user can select a different name, but
    // most users keep this value.
    //
    // Do not put "zig" in this name. The name is already in the Zig package
    // namespace.
    .name = .vig,
    // This is a [Semantic Version](https://semver.org/).
    // A later version of Zig uses it to remove duplicate packages.
    .version = "0.0.0",
    // The name and this field together are a unique identifier for the package.
    // The Zig toolchain makes this field when a user makes the package, and the
    // field then *never changes*. Therefore a user can be sure that one package
    // is a later version of a different package.
    //
    // If you fork a Zig project, and a maintainer still supports the upstream
    // project, make this identifier again: delete the field and run
    // `zig build`. If you do not, the fork is *hostile*, because it takes
    // control of the identity of the original project. Therefore keep the
    // comment on the line below. That comment then shows in a review of a
    // change to the field.
    .fingerprint = 0xc8d4e9e5948fe101, // A change to this value has effects on security and trust.
    // The earliest Zig version that the package supports.
    .minimum_zig_version = "0.17.0-dev.1543+6db520a4c",
    // This field is optional.
    // Each dependency must give a `url` and a `hash`, or a `path`.
    // `zig build --fetch` gets all the dependencies of a package, at each level.
    // After it gets all the dependencies, `zig build` needs no connection to the
    // internet.
    .dependencies = .{
        // This URL holds the version in one other position only. The build takes
        // all the values for the configuration headers of libffi from `version`
        // in build/libffi.zig. This URL must agree with that constant.
        .libffi = .{
            .url = "https://github.com/libffi/libffi/releases/download/v3.5.2/libffi-3.5.2.tar.gz",
            .hash = "N-V-__8AAFDiVQA3Q01T64sEaf0mSRyePtaGEqV9gZ37pSti",
        },
        // This package supplies the opcodes, the container format and the
        // verifier. The assembler uses the same package.
        .vig_bytecode = .{ .path = "../vig-bytecode" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        // For example:
        //"LICENSE",
        //"README.md",
    },
}
